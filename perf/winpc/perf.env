# CPU limit per container (per replica for the scalable services), cores. The host (WSL ci) has 12.
# order / inventory: the services the test scales (3 replicas = 3x the CPU for exactly those two).
ORDER_CPUS=0.5
INVENTORY_CPUS=0.5
# everything else: fixed, sized with headroom for the scaled runs (measured per order: see docs/m6-verification.md)
PAYMENT_CPUS=1
NOTIFICATION_CPUS=0.5
CATALOG_CPUS=0.25
PG_ORDER_CPUS=2
PG_INVENTORY_CPUS=2
PG_REST_CPUS=1.5
RABBITMQ_CPUS=2.5
RABBITMQ_SCHED=3
HAPROXY_CPUS=1
