{
  "$id": "inventory.reservation_failed.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "预留失败(一个 SKU 都没有预留)(事件,版本 1,主体 = data.order_id)。Code generated by factory from 消息.yaml",
  "properties": {
    "data": {
      "properties": {
        "order_id": {
          "description": "订单号",
          "pattern": "^-?[0-9]+$",
          "type": "string"
        },
        "reason": {
          "description": "INSUFFICIENT_STOCK / RELEASED",
          "type": "string"
        }
      },
      "required": [
        "order_id",
        "reason"
      ],
      "type": "object"
    },
    "id": {
      "description": "UUIDv7(平台生成;重发时不变)",
      "format": "uuid",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "traceparent": {
      "type": "string"
    },
    "type": {
      "const": "inventory.reservation_failed"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "occurred_at",
    "source",
    "subject",
    "data"
  ],
  "title": "inventory.reservation_failed",
  "type": "object",
  "x-factory": {
    "type": "inventory.reservation_failed",
    "kind": "event",
    "version": 1,
    "subject": "order_id",
    "desc": "预留失败(一个 SKU 都没有预留)",
    "fields": [
      {
        "name": "order_id",
        "type": "整数64",
        "required": true,
        "desc": "订单号"
      },
      {
        "name": "reason",
        "type": "文本",
        "required": true,
        "desc": "INSUFFICIENT_STOCK / RELEASED",
        "rules": {
          "长度": "1~32"
        }
      }
    ]
  }
}
