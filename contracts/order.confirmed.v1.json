{
  "$id": "order.confirmed.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "订单完成(库存确认、支付成功)(事件,版本 1,主体 = data.order_id)。Code generated by factory from 消息.yaml",
  "properties": {
    "data": {
      "properties": {
        "customer_id": {
          "description": "客户",
          "pattern": "^-?[0-9]+$",
          "type": "string"
        },
        "order_id": {
          "description": "订单号",
          "pattern": "^-?[0-9]+$",
          "type": "string"
        },
        "total": {
          "description": "订单金额",
          "pattern": "^\\d+(\\.\\d+)?$",
          "type": "string"
        }
      },
      "required": [
        "order_id",
        "customer_id",
        "total"
      ],
      "type": "object"
    },
    "id": {
      "description": "UUIDv7(平台生成;重发时不变)",
      "format": "uuid",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "traceparent": {
      "type": "string"
    },
    "type": {
      "const": "order.confirmed"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "occurred_at",
    "source",
    "subject",
    "data"
  ],
  "title": "order.confirmed",
  "type": "object",
  "x-factory": {
    "type": "order.confirmed",
    "kind": "event",
    "version": 1,
    "subject": "order_id",
    "desc": "订单完成(库存确认、支付成功)",
    "fields": [
      {
        "name": "order_id",
        "type": "整数64",
        "required": true,
        "desc": "订单号",
        "rules": {
          "范围": "\u003e 0"
        }
      },
      {
        "name": "customer_id",
        "type": "整数64",
        "required": true,
        "desc": "客户",
        "rules": {
          "范围": "\u003e 0"
        }
      },
      {
        "name": "total",
        "type": "非负十进制",
        "required": true,
        "desc": "订单金额"
      }
    ]
  }
}
