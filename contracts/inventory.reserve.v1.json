{
  "$id": "inventory.reserve.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "为一个订单预留库存(全部 SKU 都够才预留)(命令,版本 1,主体 = data.order_id)。Code generated by factory from 消息.yaml",
  "properties": {
    "data": {
      "properties": {
        "items": {
          "description": "每个 SKU 预留多少",
          "items": {
            "properties": {
              "qty": {
                "type": "integer"
              },
              "sku": {
                "type": "string"
              }
            },
            "required": [
              "sku",
              "qty"
            ],
            "type": "object"
          },
          "maxItems": 50,
          "minItems": 1,
          "type": "array"
        },
        "order_id": {
          "description": "订单号",
          "pattern": "^-?[0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "order_id",
        "items"
      ],
      "type": "object"
    },
    "id": {
      "description": "UUIDv7(平台生成;重发时不变)",
      "format": "uuid",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "traceparent": {
      "type": "string"
    },
    "type": {
      "const": "inventory.reserve"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "occurred_at",
    "source",
    "subject",
    "data"
  ],
  "title": "inventory.reserve",
  "type": "object",
  "x-factory": {
    "type": "inventory.reserve",
    "kind": "command",
    "version": 1,
    "subject": "order_id",
    "desc": "为一个订单预留库存(全部 SKU 都够才预留)",
    "fields": [
      {
        "name": "order_id",
        "type": "整数64",
        "required": true,
        "desc": "订单号",
        "rules": {
          "范围": "\u003e 0"
        }
      },
      {
        "name": "items",
        "type": "列表",
        "required": true,
        "desc": "每个 SKU 预留多少",
        "rules": {
          "个数": "1~50"
        },
        "elem": [
          {
            "name": "sku",
            "type": "文本",
            "required": true,
            "rules": {
              "格式": "代码",
              "长度": "3~32"
            }
          },
          {
            "name": "qty",
            "type": "整数32",
            "required": true,
            "rules": {
              "范围": "1~1000"
            }
          }
        ],
        "unique": [
          "sku"
        ]
      }
    ]
  }
}
