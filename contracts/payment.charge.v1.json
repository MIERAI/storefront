{
  "$id": "payment.charge.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "给一个订单扣款(订单号 = 幂等键)(命令,版本 1,主体 = data.order_id)。Code generated by factory from 消息.yaml",
  "properties": {
    "data": {
      "properties": {
        "amount": {
          "description": "金额",
          "pattern": "^\\d+(\\.\\d+)?$",
          "type": "string"
        },
        "order_id": {
          "description": "订单号",
          "pattern": "^-?[0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "order_id",
        "amount"
      ],
      "type": "object"
    },
    "id": {
      "description": "UUIDv7(平台生成;重发时不变)",
      "format": "uuid",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "traceparent": {
      "type": "string"
    },
    "type": {
      "const": "payment.charge"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "occurred_at",
    "source",
    "subject",
    "data"
  ],
  "title": "payment.charge",
  "type": "object",
  "x-factory": {
    "type": "payment.charge",
    "kind": "command",
    "version": 1,
    "subject": "order_id",
    "desc": "给一个订单扣款(订单号 = 幂等键)",
    "fields": [
      {
        "name": "order_id",
        "type": "整数64",
        "required": true,
        "desc": "订单号",
        "rules": {
          "范围": "\u003e 0"
        }
      },
      {
        "name": "amount",
        "type": "非负十进制",
        "required": true,
        "desc": "金额"
      }
    ]
  }
}
