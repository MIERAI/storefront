# The v2 system's messaging topology as an image: api-factory-runtime's CLI (`factory-runtime topology apply`) with
# contracts/topology.json (every queue, binding, retry queue and DLQ of the five services; generated by `factory system`)
# baked in. The platform's pre-deploy step (api-factory GAPS G23): gitops-manifests v2 runs it as a one-shot Job before
# the services, so an event sent before its subscriber's first start already has a queue. Same as api-factory
# examples/storefront-v2/e2e/topology.Dockerfile, plus the manifest.
#
#   docker run --rm -e AMQP_URL=amqp://… ghcr.io/mierai/storefront-topology topology apply --file /topology.json
#
# RUNTIME_VERSION = the runtime the services are generated against (CI checks it equals services/*/go.mod).
ARG IMAGE_MIRROR=mirror.gcr.io/library
FROM ${IMAGE_MIRROR}/golang:1.27.4-alpine AS build
ARG RUNTIME_VERSION=v0.5.1
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOBIN=/out go install -trimpath -ldflags "-s -w" \
    github.com/MIERAI/api-factory-runtime/cmd/factory-runtime@${RUNTIME_VERSION}

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/factory-runtime /factory-runtime
COPY contracts/topology.json /topology.json
USER nonroot:nonroot
ENTRYPOINT ["/factory-runtime"]
CMD ["topology", "apply", "--file", "/topology.json", "--timeout", "120s"]
